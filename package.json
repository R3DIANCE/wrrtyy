{
  "name": "wayfarer",
  "version": "0.1.0",
  "description": "A WebGPU top-down exploration game on an infinite procedural map, powered by Bun.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "build": "bun scripts/build.ts",
    "fetch-data": "bun scripts/fetch-data.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.51",
    "bun-plugin-tailwind": "^0.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@orillusion/core": "^0.9.2"
  }
}
